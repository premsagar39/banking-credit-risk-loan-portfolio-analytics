Loans = COUNTROWS(Loans)

Funded Amount = SUM(Loans[FundedAmount])

Outstanding Principal = SUM(Loans[OutstandingPrincipal])

Average Loan Size = DIVIDE([Funded Amount],[Loans])

Mean Interest Rate = AVERAGE(Loans[InterestRatePct])/100

Weighted Interest Rate = DIVIDE(SUMX(Loans,Loans[InterestRatePct]*Loans[FundedAmount]),SUMX(FILTER(Loans,NOT ISBLANK(Loans[InterestRatePct])),Loans[FundedAmount]))/100

Resolved Loans = SUM(Loans[ResolvedFlag])

Charged Off Loans = SUM(Loans[BadResolvedFlag])

Bad Resolved Share = DIVIDE([Charged Off Loans],[Resolved Loans])

Resolved Share = DIVIDE([Resolved Loans],[Loans])

Unresolved Loans = [Loans]-[Resolved Loans]

Current Loans = CALCULATE([Loans],Loans[StatusGroup]="Current")

Late or Grace Loans = CALCULATE([Loans],Loans[StatusGroup]="Late / grace")

Default Status Loans = CALCULATE([Loans],Loans[StatusGroup]="Default")

Fully Paid Loans = CALCULATE([Loans],Loans[StatusGroup]="Resolved good")

Snapshot Distress Share = DIVIDE(SUM(Loans[DistressFlag]),[Loans])

Median Stated Income = MEDIANX(FILTER(Loans,Loans[AnnualIncome]>=0),Loans[AnnualIncome])

Mean Nonnegative DTI = AVERAGEX(FILTER(Loans,Loans[DTI]>=0),Loans[DTI])

Median Origination FICO = MEDIAN(Loans[FicoMid])

Mean Term Months = AVERAGE(Loans[TermMonths])

Funding Share = DIVIDE([Funded Amount],CALCULATE([Funded Amount],ALLSELECTED(Loans)))

Exposure to Funding = DIVIDE([Outstanding Principal],[Funded Amount])

Bad Share Wilson Lower = VAR N=[Resolved Loans] VAR P=[Bad Resolved Share] RETURN IF(N>0,DIVIDE(P+3.8416/(2*N)-1.96*SQRT(P*(1-P)/N+3.8416/(4*N*N)),1+3.8416/N))

Bad Share Wilson Upper = VAR N=[Resolved Loans] VAR P=[Bad Resolved Share] RETURN IF(N>0,DIVIDE(P+3.8416/(2*N)+1.96*SQRT(P*(1-P)/N+3.8416/(4*N*N)),1+3.8416/N))