        "lineageTag": "bb6e4100-d53b-462f-bb83-6f218fa5a24d",
        "measures": [
          {
            "name": "Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "COUNTROWS(Loans)",
            "formatString": "#,0",
            "lineageTag": "ef18f769-315c-47e6-9ccb-a93a266931aa"
          },
          {
            "name": "Funded Amount",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Loans[FundedAmount])",
            "formatString": "$#,0",
            "lineageTag": "b090b60d-8bd8-442a-8787-3223d9c736b2"
          },
          {
            "name": "Outstanding Principal",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Loans[OutstandingPrincipal])",
            "formatString": "$#,0",
            "lineageTag": "2a7c6f6c-11a7-4db2-ae13-8bd29d4b0883"
          },
          {
            "name": "Average Loan Size",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Funded Amount],[Loans])",
            "formatString": "$#,0",
            "lineageTag": "f0b80119-90f7-4b2d-91ac-dd4b5ef29ec6"
          },
          {
            "name": "Mean Interest Rate",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "AVERAGE(Loans[InterestRatePct])/100",
            "formatString": "0.00%",
            "lineageTag": "e9c88295-f70b-4f34-bcd6-01385a58e7e7"
          },
          {
            "name": "Weighted Interest Rate",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE(SUMX(Loans,Loans[InterestRatePct]*Loans[FundedAmount]),SUMX(FILTER(Loans,NOT ISBLANK(Loans[InterestRatePct])),Loans[FundedAmount]))/100",
            "formatString": "0.00%",
            "lineageTag": "63a2c236-3409-487b-804e-08ad6de97674"
          },
          {
            "name": "Resolved Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Loans[ResolvedFlag])",
            "formatString": "#,0",
            "lineageTag": "59eb261b-7508-4b0c-ae17-23196648b4d6"
          },
          {
            "name": "Charged Off Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "SUM(Loans[BadResolvedFlag])",
            "formatString": "#,0",
            "lineageTag": "3d9aa0ce-3a1f-4c33-b550-f17ce5c525d2"
          },
          {
            "name": "Bad Resolved Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Charged Off Loans],[Resolved Loans])",
            "formatString": "0.0%",
            "lineageTag": "b61c264d-185a-4070-9fd2-56c4a79cbabd"
          },
          {
            "name": "Resolved Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Resolved Loans],[Loans])",
            "formatString": "0.0%",
            "lineageTag": "20e6100c-2bc5-4056-9f72-1f7fa41d2037"
          },
          {
            "name": "Unresolved Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "[Loans]-[Resolved Loans]",
            "formatString": "#,0",
            "lineageTag": "25841a96-82b3-4dc0-af1f-9da8442daa14"
          },
          {
            "name": "Current Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE([Loans],Loans[StatusGroup]=\"Current\")",
            "formatString": "#,0",
            "lineageTag": "fea03cf0-f581-4091-bf7d-2b2ff247007a"
          },
          {
            "name": "Late or Grace Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE([Loans],Loans[StatusGroup]=\"Late / grace\")",
            "formatString": "#,0",
            "lineageTag": "05809a50-9f28-4581-b91d-f547413ba2cc"
          },
          {
            "name": "Default Status Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE([Loans],Loans[StatusGroup]=\"Default\")",
            "formatString": "#,0",
            "lineageTag": "7d5b8222-40d4-4e40-8926-9797612d071f"
          },
          {
            "name": "Fully Paid Loans",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "CALCULATE([Loans],Loans[StatusGroup]=\"Resolved good\")",
            "formatString": "#,0",
            "lineageTag": "c5e39232-20bd-4a75-8df4-bf40ebda4d54"
          },
          {
            "name": "Snapshot Distress Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE(SUM(Loans[DistressFlag]),[Loans])",
            "formatString": "0.0%",
            "lineageTag": "9639d061-df63-49bb-a35a-35cd7991b765"
          },
          {
            "name": "Median Stated Income",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "MEDIANX(FILTER(Loans,Loans[AnnualIncome]>=0),Loans[AnnualIncome])",
            "formatString": "$#,0",
            "lineageTag": "28f903ce-f7e2-4bd1-a4d2-dd53bcb93b6b"
          },
          {
            "name": "Mean Nonnegative DTI",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "AVERAGEX(FILTER(Loans,Loans[DTI]>=0),Loans[DTI])",
            "formatString": "0.0",
            "lineageTag": "e1e1eb40-8777-41b2-85b2-df64f515daa6"
          },
          {
            "name": "Median Origination FICO",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "MEDIAN(Loans[FicoMid])",
            "formatString": "0",
            "lineageTag": "712c0b16-7632-45d3-876f-795221cd4bc7"
          },
          {
            "name": "Mean Term Months",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "AVERAGE(Loans[TermMonths])",
            "formatString": "0.0",
            "lineageTag": "a686790f-12c3-41ad-a263-6bc03c6d2398"
          },
          {
            "name": "Funding Share",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Funded Amount],CALCULATE([Funded Amount],ALLSELECTED(Loans)))",
            "formatString": "0.0%",
            "lineageTag": "1656de75-e58f-4ac2-9bfd-5eae812851f2"
          },
          {
            "name": "Exposure to Funding",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "DIVIDE([Outstanding Principal],[Funded Amount])",
            "formatString": "0.0%",
            "lineageTag": "0d57e7cf-865b-428f-bfd6-84def2548b22"
          },
          {
            "name": "Bad Share Wilson Lower",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "VAR N=[Resolved Loans] VAR P=[Bad Resolved Share] RETURN IF(N>0,DIVIDE(P+3.8416/(2*N)-1.96*SQRT(P*(1-P)/N+3.8416/(4*N*N)),1+3.8416/N))",
            "formatString": "0.0%",
            "lineageTag": "0720820e-f13f-472d-8d00-d6c5560172cc"
          },
          {
            "name": "Bad Share Wilson Upper",
            "description": "See powerbi/MEASURE_DEFINITIONS.md for context and scope.",
            "displayFolder": "Portfolio Measures",
            "expression": "VAR N=[Resolved Loans] VAR P=[Bad Resolved Share] RETURN IF(N>0,DIVIDE(P+3.8416/(2*N)+1.96*SQRT(P*(1-P)/N+3.8416/(4*N*N)),1+3.8416/N))",
            "formatString": "0.0%",
            "lineageTag": "6a8c4417-3a59-4586-80f5-f5b590a971dd"
          },
          {
            "name": "Outcome Gap pp",
            "expression": "VAR B=CALCULATE([Bad Resolved Share],ALLSELECTED(Loans[VintageYear])) RETURN IF(NOT ISBLANK([Bad Resolved Share]) && NOT ISBLANK(B),100*([Bad Resolved Share]-B))",
            "formatString": "0.0 \"pp\";-0.0 \"pp\"",
            "displayFolder": "Comparisons",
            "description": "Charged-off share among resolved loans minus the selected-vintage weighted share; percentage points.",
            "lineageTag": "dc538e04-bed8-565b-935e-e4323254eb48"
          },
          {
            "name": "Coverage Gap pp",
            "expression": "VAR B=CALCULATE([Resolved Share],ALLSELECTED(Loans[VintageYear])) RETURN IF([Loans]>0,100*([Resolved Share]-B))",
            "formatString": "0.0 \"pp\";-0.0 \"pp\"",
            "displayFolder": "Comparisons",
            "description": "Resolved share minus selected-vintage weighted coverage; percentage points. Not a maturity adjustment.",
            "lineageTag": "ab7d5727-d32d-534c-91b3-5348d382d6f8"
          }
        ],
        "partitions": [
          {
            "name": "Loans",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataRoot & \"processed/loans.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"LoanKey\", Int64.Type}, {\"SourceLoanID\", type text}, {\"LoanAmount\", type number}, {\"FundedAmount\", type number}, {\"InterestRatePct\", type number}, {\"Grade\", type text}, {\"SubGrade\", type text}, {\"LoanStatus\", type text}, {\"AnnualIncome\", type number}, {\"DTI\", type number}, {\"Purpose\", type text}, {\"State\", type text}, {\"HomeOwnership\", type text}, {\"ApplicationType\", type text}, {\"OutstandingPrincipal\", type number}, {\"TotalPayment\", type number}, {\"Recoveries\", type number}, {\"EmploymentLength\", type text}, {\"IssueDate\", type datetime}, {\"LastPaymentDate\", type datetime}, {\"TermMonths\", Int64.Type}, {\"IssueMonth\", type text}, {\"VintageYear\", Int64.Type}, {\"StatusGroup\", type text}, {\"ResolvedFlag\", Int64.Type}, {\"BadResolvedFlag\", Int64.Type}, {\"DistressFlag\", Int64.Type}, {\"IncomeBand\", type text}, {\"DtiBand\", type text}, {\"FicoMid\", type number}},\"en-US\")",
                "in Typed"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}
